# Copie para .env na mesma pasta (ou exporte no Portainer / Swarm):
#   cp .env.example .env

# LightRAG upstream
LIGHTRAG_SERVER_URL=http://host.docker.internal:9621
LIGHTRAG_API_KEY=
LIGHTRAG_TIMEOUT_MS=120000
# LIGHTRAG_WORKSPACE=

# Versão npm do pacote MCP (stdio / sse / swarm)
PW2C_LIGHTRAG_MCP_VERSION=1.2.0

# Modo HTTP (--sse) apenas
MCP_HTTP_PORT=8000
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_HEADER_OVERRIDES=true
MCP_ALLOWED_LIGHTRAG_HOSTS=*
